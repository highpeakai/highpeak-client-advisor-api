{
  "info": {
    "_postman_id": "d0d5d7d5-1f7b-435f-8cb4-e1e26dcdd206",
    "name": "HighPeak API",
    "description": "Model query endpoints behind the HighPeak API Gateway, built from openapi.yaml (HP2-2165).\n\nSelect the Dev, QA or Prod environment and set `apiKey` (X-API-Key header). Also set `bearerToken` to a Cognito ID/access token for a user in Admins or EnterpriseManagers: the model Lambdas verify it themselves (highpeak-auth-layer). The pre-request script adds `Authorization: Bearer <token>`.\n\nFolders: **Happy path** checks each endpoint returns 200 with the response shape from the spec; **Auth** checks the gateway rejects missing/invalid keys; **Validation** checks bad bodies return 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Add a Cognito bearer token when one is set, unless the request opts out of auth.",
          "const token = pm.variables.get(\"bearerToken\");",
          "const noAuth = pm.request.auth && pm.request.auth.type === \"noauth\";",
          "const skip = pm.info.requestName.includes(\"no bearer token\");",
          "if (token && !noAuth && !skip) {",
          "  pm.request.headers.upsert({ key: \"Authorization\", value: `Bearer ${token}` });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"responds within 30s\", () => pm.expect(pm.response.responseTime).to.be.below(30000));"
        ]
      }
    }
  ],
  "item": [
