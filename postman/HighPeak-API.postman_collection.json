        {
          "name": "LTC probability",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"response is JSON\", () => pm.response.to.be.json);",
                  "const body = pm.response.json();",
                  "pm.test(\"has ltc_need_proba\", () => pm.expect(body).to.have.property(\"ltc_need_proba\"));",
                  "pm.test(\"ltc_need_proba.proba_mean is a number\", () => pm.expect(body.ltc_need_proba.proba_mean).to.be.a(\"number\"));",
                  "pm.test(\"ltc_need_proba.proba_std is a number\", () => pm.expect(body.ltc_need_proba.proba_std).to.be.a(\"number\"));",
                  "pm.test(\"ltc_need_proba.count is a number\", () => pm.expect(body.ltc_need_proba.count).to.be.a(\"number\"));",
                  "pm.test(\"unit is %\", () => pm.expect(body.ltc_need_proba.unit).to.eql(\"%\"));"
                ]
